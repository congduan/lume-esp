# Lume firmware defaults — common (board-independent) settings.
#
# Board-specific values (flash size / PSRAM / console / partition table /
# LVGL color depth) live in firmware/boards/<board>/sdkconfig.defaults and are
# applied on top of this file through the SDKCONFIG_DEFAULTS list in
# firmware/CMakeLists.txt. See firmware/boards/README.md.

# Target
CONFIG_IDF_TARGET="esp32s3"

# Compiler optimisation (r43b). IDF's default is CONFIG_COMPILER_OPTIMIZATION_DEBUG
# (-Og), which was silently costing a large share of the QuickJS interpreter and LVGL
# software-rendering throughput. -O2 keeps assertions enabled (see ASSERTIONS_ENABLE
# below) so failure modes are unchanged; only code generation differs.
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_ENABLE=y

# FreeRTOS tick for smooth UI
CONFIG_FREERTOS_HZ=1000

# 240 MHz: a full-screen repaint is dominated by LVGL software rendering
# (~39 ms at 160 MHz vs ~16 MB/s QSPI flush, measured in docs r28).
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# WiFi OTA push channel TCP port (r26, Kconfig LUME_OTA_PORT)
CONFIG_LUME_OTA_PORT=8765

# TF card (SPI mode) support
CONFIG_FATFS_LFN_STACK=y
CONFIG_FATFS_MAX_LFN=128
CONFIG_FATFS_API_ENCODING_UTF_8=y

# WiFi station IRAM mitigation (r11): the 16 KB IRAM is 100% full at the r10
# baseline (16384/16384, Remain 0). esp_wifi's IRAM_OPT/RX_IRAM_OPT place the
# hot-path functions (libpp.a / libnet80211.a .wifi0iram/.wifirxiram sections)
# into iram0_text via components/esp_wifi/linker.lf, which would overflow IRAM
# the moment the WiFi library is linked by lume-net. Disabling both keeps those
# functions in flash (supported: esp_wifi/Kconfig:274-299, >10K + >17K IRAM
# saved) at the cost of WiFi throughput. EXTRA_IRAM_OPT / SLP_IRAM_OPT stay off.
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n

# r179: WiFi station must associate through esp-emu. BT_ENABLED=y (r25 NimBLE)
# selects CONFIG_ESP_COEX_SW_COEXIST_ENABLE; r175 R4b proved that turning it
# off flips assoc -> init (0x400) into assoc -> run (0x10). All three legacy
# aliases in sdkconfig.rename map to this one symbol; setting it n here is
# the single declarative source of truth. Combined with esp_wifi_set_ps()
# in lume_net.c. Real-board coexistence/WiFi behaviour remains deferred.
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=n

# BLE peripheral / NimBLE (r25, lume-ble). These are the Kconfig inputs;
# firmware/sdkconfig was regenerated with idf.py v5.5.5 so a plain build has
# Bluetooth enabled. Host build + size: IRAM 16384/16384 (100%, no overflow),
# DIRAM 227975, Flash Code 1657930, app partition 67% free. IRAM has ZERO bytes
# free, so re-check `idf.py size` after any new IRAM symbol. Real WiFi+BLE
# coexistence still needs board acceptance (docs/KNOWN-SIMPLIFICATIONS.md r25).
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1

# HTTPS verifies with the certificate bundle unless httpsInsecure is explicitly
# requested. IDF's skip-default switch affects only requests without a CA.
CONFIG_ESP_TLS_INSECURE=y
CONFIG_ESP_TLS_SKIP_SERVER_CERT_VERIFY=y

# SNTP wall clock (r128). lume.system.setTimeNtp() drives esp_netif_sntp's
# bounded synchronous wait, so one server slot (the default pool.ntp.org) is
# enough; keeping the count at 1 minimises the flash/runtime footprint. The
# 1h update delay bounds periodic resync traffic if SNTP is left running by
# another caller. IRAM: SNTP runs entirely on the tcpip task in flash, so the
# 16384/16384 IRAM budget stays at Remain 0.
CONFIG_LWIP_SNTP_MAX_SERVERS=1
CONFIG_LWIP_SNTP_UPDATE_DELAY=3600000
