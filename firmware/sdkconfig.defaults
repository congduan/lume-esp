# Lume firmware defaults — Waveshare ESP32-S3-Touch-AMOLED-2.16
# Based on the vendor example sdkconfig (validated on this board).

# Target
CONFIG_IDF_TARGET="esp32s3"

# 16MB flash
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# 8MB Octal PSRAM — engine heap lives here
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=4096
CONFIG_SPIRAM_USE_MALLOC=y

# FreeRTOS tick for smooth UI
CONFIG_FREERTOS_HZ=1000

# 240 MHz: a full-screen repaint is dominated by LVGL software rendering
# (~39 ms at 160 MHz vs ~16 MB/s QSPI flush, measured in docs r28).
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# USB CDC console (hot-reload channel + logs)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# WiFi OTA push channel TCP port (r26, Kconfig LUME_OTA_PORT)
CONFIG_LUME_OTA_PORT=8765

# Partition table: app + LittleFS-style data partition
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# LVGL render backend
CONFIG_LV_COLOR_DEPTH_16=y

# TF card (SPI mode) support
CONFIG_FATFS_LFN_STACK=y
CONFIG_FATFS_MAX_LFN=128

# WiFi station IRAM mitigation (r11): the 16 KB IRAM is 100% full at the r10
# baseline (16384/16384, Remain 0). esp_wifi's IRAM_OPT/RX_IRAM_OPT place the
# hot-path functions (libpp.a / libnet80211.a .wifi0iram/.wifirxiram sections)
# into iram0_text via components/esp_wifi/linker.lf, which would overflow IRAM
# the moment the WiFi library is linked by lume-net. Disabling both keeps those
# functions in flash (supported: esp_wifi/Kconfig:274-299, >10K + >17K IRAM
# saved) at the cost of WiFi throughput. EXTRA_IRAM_OPT / SLP_IRAM_OPT stay off.
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n

# BLE peripheral / NimBLE (r25, lume-ble). These are the Kconfig inputs;
# firmware/sdkconfig was regenerated with idf.py v5.5.5 so a plain build has
# Bluetooth enabled. Host build + size: IRAM 16384/16384 (100%, no overflow),
# DIRAM 227975, Flash Code 1657930, app partition 67% free. IRAM has ZERO bytes
# free, so re-check `idf.py size` after any new IRAM symbol. Real WiFi+BLE
# coexistence still needs board acceptance (docs/KNOWN-SIMPLIFICATIONS.md r25).
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
