# Lume firmware defaults — Waveshare ESP32-S3-Touch-AMOLED-2.16
# Based on the vendor example sdkconfig (validated on this board).

# Target
CONFIG_IDF_TARGET="esp32s3"

# 16MB flash
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# 8MB Octal PSRAM — engine heap lives here
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=4096
CONFIG_SPIRAM_USE_MALLOC=y

# FreeRTOS tick for smooth UI
CONFIG_FREERTOS_HZ=1000

# USB CDC console (hot-reload channel + logs)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Partition table: app + LittleFS-style data partition
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# LVGL render backend
CONFIG_LV_COLOR_DEPTH_16=y

# TF card (SPI mode) support
CONFIG_FATFS_LFN_STACK=y
CONFIG_FATFS_MAX_LFN=128
