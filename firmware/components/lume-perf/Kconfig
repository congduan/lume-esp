menu "Lume performance experiments"
    config LUME_PERF_PROFILE
        bool "One-second performance summary"
        default n
    config LUME_DRAW_BUF_LINES
        int "Preferred DMA draw buffer height (20 or 48)"
        range 20 48
        default 20
    config LUME_REFRESH_PERIOD_MS
        int "LVGL refresh period in milliseconds (10, 15, or 33)"
        range 10 33
        default 33
    config LUME_SWITCH_PROFILE
        bool "r46: log per-phase app-switch timing (opt-in measurement, default off)"
        default n
        help
          Emits one lume-perf "switch:" line per app switch with teardown
          (JS_FreeRuntime broken out), runtime creation (NewRuntime2 /
          NewContext / register_bindings broken out), prelude eval and app
          eval phases, plus SWMARK checkpoints and an LVGL-side first-frame
          latency line. Uses emulated microseconds (deterministic under
          esp32sim), NOT wall-clock. Off by default: no production overhead.
endmenu
