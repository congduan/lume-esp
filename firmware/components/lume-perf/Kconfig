menu "Lume performance experiments"
    config LUME_PERF_PROFILE
        bool "One-second performance summary"
        default n
    config LUME_DRAW_BUF_LINES
        int "Preferred DMA draw buffer height (20 or 48)"
        range 20 48
        default 20
    config LUME_REFRESH_PERIOD_MS
        int "LVGL refresh period in milliseconds (10, 15, or 33)"
        range 10 33
        default 33
    config LUME_SWITCH_PROFILE
        bool "r46: log per-phase app-switch timing (opt-in measurement, default off)"
        default n
        help
          Emits one lume-perf "switch:" line per app switch with teardown
          (JS_FreeRuntime broken out), runtime creation (NewRuntime2 /
          NewContext / register_bindings broken out), prelude eval and app
          eval phases, plus SWMARK checkpoints and an LVGL-side first-frame
          latency line. Uses emulated microseconds (deterministic under
          esp32sim), NOT wall-clock. Off by default: no production overhead.
endmenu

menu "Lume app-switch transition (r46)"
    config LUME_APP_TRANSITION_DISABLE
        bool "Disable crossfade-through-black (=y: behave like pre-r46 baseline)"
        default n
        help
          Regression switch. When enabled, launch/reload tears down and
          rebuilds exactly as before r46 (synchronous RESET, blank period,
          no overlay, no fade). The engine does not wait for any cover
          handshake and does not post the FIRSTFRAME reveal trigger.
    config LUME_APP_TRANSITION_MS
        int "Crossfade fade-in / fade-out duration (ms)"
        range 100 500
        default 200
        help
          Duration of each opacity fade on the LVGL task. The overlay fades
          in to opaque black before teardown and back out after the new
          app's first frame. 500 ms is a fixed LVGL-side reveal fallback.
endmenu
