# Board defaults — Waveshare ESP32-S3-Touch-AMOLED-2.16
#
# Selected (together with the common firmware/sdkconfig.defaults) through the
# SDKCONFIG_DEFAULTS list in firmware/CMakeLists.txt. A different board is
# selected with:
#   idf.py -DSDKCONFIG_DEFAULTS="sdkconfig.defaults;boards/<name>/sdkconfig.defaults" build
# See firmware/boards/README.md.

# Select this board profile (Kconfig choice LUME_BOARD).
CONFIG_LUME_BOARD_WAVESHARE_ESP32_S3_TOUCH_AMOLED_2_16=y

# 16MB flash
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# 8MB Octal PSRAM — engine heap lives here
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=4096
CONFIG_SPIRAM_USE_MALLOC=y

# USB CDC console (hot-reload channel + logs)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Partition table: board flash layout (path is project-root-relative)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="boards/waveshare_esp32_s3_touch_amoled_2_16/partitions.csv"

# LVGL render backend color depth (matches RGB565 QSPI framebuffer)
CONFIG_LV_COLOR_DEPTH_16=y
