diff --git a/esp32s3/src/board/lume_amoled216.rs b/esp32s3/src/board/lume_amoled216.rs
new file mode 100644
index 0000000..ec8f30b
--- /dev/null
+++ b/esp32s3/src/board/lume_amoled216.rs
@@ -0,0 +1,127 @@
+//! Lume Waveshare ESP32-S3-Touch-AMOLED-2.16 wiring.
+//! Source: firmware/boards/waveshare_esp32_s3_touch_amoled_2_16/lume_board_profile.h.
+use esp_soc::board::BoardModel;
+use crate::i2c::{I2cDevice, ImuMotion, Qmi8658, Reg8Device, TouchState};
+use esp_soc::devices::co5300::Co5300;
+use std::sync::{Arc, Mutex};
+
+// Physical wiring from Lume's lume_board_profile.h. The current peripheral
+// models bind by SPI host and I2C bus/address; these names make the board
+// mapping explicit even where esp32sim has no electrical pin routing yet.
+pub const PIN_LCD_SCLK: u8 = 38;
+pub const PIN_LCD_DATA: [u8; 4] = [4, 5, 6, 7];
+pub const PIN_LCD_CS: u8 = 12;
+pub const PIN_LCD_RST: u8 = 39;
+pub const PIN_I2C_SDA: u8 = 15;
+pub const PIN_I2C_SCL: u8 = 14;
+pub const PIN_TOUCH_INT: u8 = 11;
+pub const PIN_TOUCH_RST: u8 = 40;
+pub const PIN_I2S_MCLK: u8 = 42;
+pub const PIN_I2S_SCLK: u8 = 9;
+pub const PIN_I2S_LRCK: u8 = 45;
+pub const PIN_I2S_DOUT: u8 = 8;
+pub const PIN_I2S_DIN: u8 = 10;
+pub const PIN_SD_MOSI: u8 = 1;
+pub const PIN_SD_CLK: u8 = 2;
+pub const PIN_SD_MISO: u8 = 3;
+pub const PIN_SD_CS: u8 = 41;
+
+pub struct LumeAmoled216 {
+    panel: Co5300,
+    touch: Arc<Mutex<TouchState>>,
+    imu: Arc<ImuMotion>,
+    imu_present: bool,
+}
+
+impl LumeAmoled216 {
+    pub fn new() -> Self {
+        Self { panel: Co5300::new(480, 480, 0), touch: Default::default(), imu: Default::default(), imu_present: true }
+    }
+    pub fn without_imu() -> Self { Self { imu_present: false, ..Self::new() } }
+}
+
+impl BoardModel for LumeAmoled216 {
+    fn name(&self) -> &'static str { if self.imu_present { "lume-amoled216" } else { "lume-amoled216-no-imu" } }
+    fn spi_transfer(&mut self, host: u8, tx: &[u8], rx_len: usize) -> Vec<u8> {
+        if host == 2 { self.panel.transaction(tx); }
+        vec![0xff; rx_len]
+    }
+    fn i2c_devices(&mut self) -> Vec<(u8, u8, Box<dyn I2cDevice>)> {
+        let mut devices: Vec<(u8, u8, Box<dyn I2cDevice>)> = vec![
+            (0, 0x5a, Box::new(Cst9220::new(self.touch.clone()))),
+            (0, 0x34, Box::new(Reg8Device::new("axp2101-pmic-initialization-stub", &[(0x03, 0x4a)]))),
+            (0, 0x18, Box::new(Reg8Device::new("es8311-codec-initialization-stub", &[]))),
+            (0, 0x40, Box::new(Reg8Device::new("es7210-adc-initialization-stub", &[]))),
+        ];
+        if self.imu_present { devices.push((0, 0x6b, Box::new(Qmi8658::new(self.imu.clone())))); }
+        devices
+    }
+    fn input_levels(&self) -> Vec<(u8, bool)> { vec![(PIN_TOUCH_INT, true)] }
+    fn display(&self) -> Option<(u32, u32, Vec<u16>, u64)> {
+        Some((480, 480, self.panel.frame.clone(), self.panel.pixels_written))
+    }
+    fn display_version(&self) -> u64 { self.panel.pixels_written }
+    fn display_frames(&self) -> u64 { self.panel.frames }
+    fn touch(&mut self, x: u16, y: u16, down: bool) {
+        // Inverse of LUME_TOUCH_MAP_X(tx,ty)=480-ty, MAP_Y(tx,ty)=tx.
+        self.touch.lock().unwrap().update(y.min(479), 480-x.min(479), down);
+    }
+    fn set_imu_motion(&mut self, mode: u32) -> bool {
+        if !self.imu_present { return false; }
+        self.imu.mode.store(mode, std::sync::atomic::Ordering::Relaxed); true
+    }
+    fn imu_motion(&self) -> u32 { self.imu.mode.load(std::sync::atomic::Ordering::Relaxed) }
+}
+
+/// CST9220/CST9217 register protocol used by Lume's lume_touch.c.
+struct Cst9220 {
+    addr: u16,
+    phase: u8,
+    offset: usize,
+    touch: Arc<Mutex<TouchState>>,
+    frame: [u8; 10],
+}
+impl Cst9220 {
+    fn new(touch: Arc<Mutex<TouchState>>) -> Self {
+        Self { addr: 0, phase: 0, offset: 0, touch, frame: [0; 10] }
+    }
+    fn refresh_frame(&mut self) {
+        let mut t = self.touch.lock().unwrap();
+        if t.release_pending && t.seen { t.down = false; t.release_pending = false; }
+        self.frame = [0; 10];
+        if t.down {
+            self.frame[0] = 0x06;
+            self.frame[1] = (t.x >> 4) as u8;
+            self.frame[2] = (t.y >> 4) as u8;
+            self.frame[3] = ((t.x as u8 & 0x0f) << 4) | (t.y as u8 & 0x0f);
+            self.frame[5] = 1;
+            t.seen = true;
+        }
+        self.frame[6] = 0xab;
+    }
+}
+impl I2cDevice for Cst9220 {
+    fn start(&mut self, read: bool) -> bool {
+        if read { self.offset = 0; if self.addr == 0xd000 { self.refresh_frame(); } }
+        else { self.phase = 0; }
+        true
+    }
+    fn write(&mut self, b: u8) -> bool {
+        match self.phase {
+            0 => { self.addr = (b as u16) << 8; self.phase = 1; }
+            1 => { self.addr |= b as u16; self.phase = 2; }
+            _ => {}
+        }
+        true
+    }
+    fn read(&mut self) -> u8 {
+        let v = match self.addr {
+            0xd000 => self.frame.get(self.offset).copied().unwrap_or(0),
+            0xd1f8 => [0xe0, 0x01, 0xe0, 0x01].get(self.offset).copied().unwrap_or(0),
+            0xd1fc => [0xab, 0xcd, 0x12, 0x34].get(self.offset).copied().unwrap_or(0),
+            _ => 0,
+        };
+        self.offset += 1;
+        v
+    }
+}
